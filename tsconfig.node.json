{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.*",
    "src/main/**/*",
    "src/preload/**/*",
    "e2e/**/*",
    "playwright.config.ts",
    "src/shared/**/*",
    "vitest.config.ts",
    "eslint.config.mjs"
  ],
  "compilerOptions": {
    "composite": true,
    "types": [
      "electron-vite/node",
      "node"
    ]
  }
}
