# Nexus One — local app state, never committed
node_modules/
out/
dist/
dist-electron/
*.log

# App data lives in Electron userData (encrypted vault), never in repo — guard anyway
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Реальный флот владельца (настоящие IP + пути к ключам) — только локально, НЕ в git.
# Демо-флот с маскированными IP лежит в src/main/seed.ts как fallback.
fleet.local.json

# Реестр AI-доступов владельца (почты, тарифы, указатели на ключи) — только локально.
# Значений ключей в нём нет: он ссылается на имена переменных в secrets/env/api-keys.env.
ai.local.json
subs.local.json

.DS_Store

# Скомпилированный агент — артефакт сборки, а не исходник. Собирается agent/build-all.sh
# в resources/agent/ (там он тоже игнорируется). Один такой бинарь уже уехал в историю
# коммитом 942d9ce — 10 МБ; в рабочем дереве его больше не отслеживаем.
agent/argus-agent
agent/argus-agent.exe

